# ─────────────────────────────────────────────────────────────────────────────
# Copier ce fichier en ".env" puis compléter les valeurs (ne jamais publier le .env).
# ─────────────────────────────────────────────────────────────────────────────

# Configuration Discord (portail développeur : même application pour les trois valeurs)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Propriétaires du bot (IDs séparés par des virgules) : /modules (rechargement), /blacklist, /unblacklist,
# accès au panel web sur tous les serveurs. Vide = AUTHORIZED_WEB_USERS.
BOT_OWNERS=

# Configuration Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=discord_bot_db

# Configuration Web & Sécurité
WEB_ENABLED=true
# En conteneur Docker (Pterodactyl, Pelican…), SERVER_PORT est prioritaire sur WEB_PORT.
WEB_PORT=3000
WEB_CALLBACK_URL=http://localhost:3000/auth/discord/callback
# Secret de signature des cookies de session (longue chaîne aléatoire, 48 caractères ou plus).
SESSION_SECRET=
# Mettre à true si le dashboard est derrière un reverse proxy (nginx, Caddy…).
TRUST_PROXY=false

# Comptes Discord autorisés à se connecter au dashboard (IDs séparés par des virgules). Hors propriétaires du
# bot, chacun n'y voit que les serveurs dont il est membre, selon ses droits (/permission grant-panel).
AUTHORIZED_WEB_USERS=

# Modules désactivés (noms séparés par des virgules, ex: stats)
DISABLED_MODULES=
# Niveau de logs : debug, info, warn, error
LOG_LEVEL=info

# ── Module Statistiques ─────────────────────────────────────────────────────
# Enregistrer le contenu des messages (sinon : métadonnées uniquement).
# Vérifiez que c'est légalement justifié (RGPD) avant d'activer.
STATS_STORE_MESSAGE_CONTENT=false
# Contenu des messages effacé au-delà de ce nombre de jours (0 ou absent = jamais ; les statistiques restent).
# Recommandé si STATS_STORE_MESSAGE_CONTENT=true. Attention : l'effacement est définitif.
STATS_CONTENT_RETENTION_DAYS=90
# Nombre de jours récupérés rétroactivement à l'arrivée sur un serveur.
STATS_BACKFILL_DAYS=7
# Fréquence des instantanés (nombre de membres, boosts, Nitro), en minutes.
STATS_SNAPSHOT_INTERVAL_MINUTES=60
# Ne pas compter le temps passé dans le salon AFK du serveur.
STATS_VOICE_EXCLUDE_AFK=true

# ── Module RôleMenu ─────────────────────────────────────────────────────────
# Autoriser des rôles portant des permissions sensibles (jamais le rôle Administrateur).
ROLEMENU_ALLOW_SENSITIVE_ROLES=false

# ── Module Server Manager (/rollback) ───────────────────────────────────────
SERVERMANAGER_MAX_WINDOW_HOURS=168
SERVERMANAGER_MAX_ACTIONS=60
SERVERMANAGER_RETENTION_DAYS=30
SERVERMANAGER_COOLDOWN_SECONDS=120

# ── Module Tickets ──────────────────────────────────────────────────────────
# Fréquence de recalcul des listes /ticket autolist (« attente du staff / du membre »), en minutes (0 = jamais).
TICKETS_AUTOLIST_REFRESH_MINUTES=5
